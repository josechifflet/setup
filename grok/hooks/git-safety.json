{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.grok/hooks/block-dangerous-git.sh",
            "env": { "GIT_GUARD_JSON": "1" },
            "timeout": 10
          }
        ]
      }
    ]
  }
}
