{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "autoInstallIdeExtension": false,
  "autoMemoryEnabled": false,
  "availableModels": [
    "claude-fable-5-1",
    "claude-opus-5-5",
    "claude-sonnet-5-5"
  ],
  "cleanupPeriodDays": 3650,
  "deniedMcpServers": [
    {
      "serverUrl": "https://gmailmcp.googleapis.com/mcp/*"
    },
    {
      "serverUrl": "https://calendarmcp.googleapis.com/mcp/*"
    },
    {
      "serverUrl": "https://drivemcp.googleapis.com/mcp/*"
    }
  ],
  "disableArtifact": true,
  "disableAutoMode": "disable",
  "disableClaudeAiConnectors": true,
  "disableRemoteControl": true,
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "paper-desktop@paper": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "enforceAvailableModels": true,
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "400000",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2",
    "CLAUDE_CODE_THRIFTY_SONIC": "0",
    "DISABLE_ERROR_REPORTING": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "GIT_EDITOR": "true",
    "GIT_MERGE_AUTOEDIT": "no",
    "GIT_SEQUENCE_EDITOR": "true"
  },
  "extraKnownMarketplaces": {
    "paper": {
      "source": {
        "repo": "paper-design/agent-plugins",
        "source": "github"
      }
    }
  },
  "forceLoginMethod": "claudeai",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/block-dangerous-git.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/block-worktree.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Agent|Task|Workflow"
      }
    ]
  },
  "includeGitInstructions": false,
  "model": "claude-opus-5-5[1m]",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(shellcheck *)",
      "Bash(shfmt *)",
      "Bash(zsh -n *)"
    ],
    "defaultMode": "acceptEdits",
    "deny": [
      "EnterPlanMode",
      "EnterWorktree",
      "Agent(isolation:worktree)",
      "DesignSync",
      "PushNotification",
      "RemoteTrigger",
      "ScheduleWakeup",
      "CronCreate",
      "CronDelete",
      "Bash(git reset *)",
      "Bash(git clean -*f*)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git branch -m *)",
      "Bash(git branch -M *)",
      "Bash(git branch -f *)",
      "Bash(git branch --delete*)",
      "Bash(git branch --move*)",
      "Bash(git branch --force*)",
      "Bash(git checkout *)",
      "Bash(git restore*)",
      "Bash(git stash*)",
      "Bash(git switch *)",
      "Bash(git bisect *)",
      "Bash(git rebase*)",
      "Bash(git commit --amend*)",
      "Bash(git rm *)",
      "Bash(git gc*)",
      "Bash(git prune*)",
      "Bash(git reflog expire*)",
      "Bash(git update-ref*)",
      "Bash(git worktree remove*)",
      "Bash(git worktree prune*)",
      "Bash(git worktree add *)",
      "Bash(gh pr checkout *)",
      "Bash(wt switch *)"
    ]
  },
  "respectGitignore": false,
  "skillOverrides": {
    "batch": "off",
    "dataviz": "off",
    "design": "off",
    "design-sync": "off",
    "fewer-permission-prompts": "off",
    "keybindings-help": "off",
    "ponytail": "off",
    "slides": "off",
    "update-config": "off"
  },
  "spinnerTipsEnabled": false,
  "statusLine": {
    "command": "~/.claude/statusline-command.sh",
    "type": "command"
  },
  "syncClaudeAiSkills": false,
  "voice": {
    "enabled": true,
    "mode": "hold"
  }
}
