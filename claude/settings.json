{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "autoInstallIdeExtension": false,
  "autoMemoryEnabled": false,
  "availableModels": ["claude-fable-5-1", "claude-opus-5-5", "claude-sonnet-5"],
  "cleanupPeriodDays": 30,
  "deniedMcpServers": [
    {
      "serverUrl": "https://gmailmcp.googleapis.com/mcp/*"
    },
    {
      "serverUrl": "https://calendarmcp.googleapis.com/mcp/*"
    },
    {
      "serverUrl": "https://drivemcp.googleapis.com/mcp/*"
    }
  ],
  "disableArtifact": true,
  "disableAutoMode": "disable",
  "disableBundledSkills": true,
  "disableClaudeAiConnectors": true,
  "disableRemoteControl": true,
  "effortLevel": "xhigh",
  "enableAllProjectMcpServers": false,
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "paper-desktop@paper": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "enforceAvailableModels": true,
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "600000",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "GIT_EDITOR": "true",
    "GIT_MERGE_AUTOEDIT": "no",
    "GIT_SEQUENCE_EDITOR": "true"
  },
  "extraKnownMarketplaces": {
    "paper": {
      "source": {
        "repo": "paper-design/agent-plugins",
        "source": "github"
      }
    }
  },
  "forceLoginMethod": "claudeai",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/block-dangerous-git.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ]
  },
  "includeGitInstructions": false,
  "model": "claude-opus-5-5[1m]",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(shellcheck *)",
      "Bash(shfmt *)",
      "Bash(zsh -n *)"
    ],
    "defaultMode": "acceptEdits",
    "deny": [
      "EnterPlanMode",
      "DesignSync",
      "PushNotification",
      "RemoteTrigger",
      "ScheduleWakeup",
      "CronCreate",
      "CronDelete",
      "Bash(git reset *)",
      "Bash(git clean -*f*)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git branch -m *)",
      "Bash(git branch -M *)",
      "Bash(git branch -f *)",
      "Bash(git branch --delete*)",
      "Bash(git branch --move*)",
      "Bash(git branch --force*)",
      "Bash(git checkout -- *)",
      "Bash(git checkout * -- *)",
      "Bash(git checkout -f*)",
      "Bash(git checkout -B *)",
      "Bash(git checkout --force*)",
      "Bash(git restore*)",
      "Bash(git stash*)",
      "Bash(git switch -f*)",
      "Bash(git switch -C *)",
      "Bash(git switch --force*)",
      "Bash(git switch --discard-changes*)",
      "Bash(git rebase*)",
      "Bash(git commit --amend*)",
      "Bash(git rm *)",
      "Bash(git gc*)",
      "Bash(git prune*)",
      "Bash(git reflog expire*)",
      "Bash(git update-ref*)",
      "Bash(git worktree remove*)",
      "Bash(git worktree prune*)"
    ]
  },
  "respectGitignore": false,
  "skillOverrides": {
    "paper-desktop:design-to-code": "user-invocable-only"
  },
  "spinnerTipsEnabled": false,
  "statusLine": {
    "command": "~/.claude/statusline-command.sh",
    "type": "command"
  },
  "syncClaudeAiSkills": false,
  "voice": {
    "enabled": true,
    "mode": "hold"
  }
}
