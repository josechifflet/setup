# Prefix rules are a backstop, not a shell parser. The managed Bash hook handles
# git global options, reordered flags, wrappers and the mixed read/write commands.
# Authorization for add, commit and plain push remains in AGENTS.md.

prefix_rule(
    pattern = ["git", ["am", "apply", "bisect", "checkout", "cherry-pick", "clone", "fetch", "gc", "init", "merge", "mv", "prune", "pull", "rebase", "replace", "reset", "restore", "revert", "rm", "switch", "update-index", "update-ref"]],
    decision = "forbidden",
    justification = "The user leaves git writes other than add, commit and plain push to themselves. Give the user the exact command and continue on this checkout.",
    match = ["git reset --hard HEAD~1", "git switch main", "git checkout -b feature", "git fetch origin"],
    not_match = ["git status", "git branch -a", "git stash list", "git add file", "git commit -m message", "git push"],
)

prefix_rule(
    pattern = ["git", "clean", ["-f", "-fd", "-xdf", "--force"]],
    decision = "forbidden",
    justification = "Leave deletion of untracked files to the user. The Bash hook checks other flag orders and combinations too.",
    match = ["git clean -fd", "git clean --force"],
    not_match = ["git clean -n", "git clean --dry-run"],
)

prefix_rule(
    pattern = ["git", "branch", ["-d", "-D", "-m", "-M", "-f", "-c", "-C", "--delete", "--move", "--force", "--copy"]],
    decision = "forbidden",
    justification = "Only the user creates, moves, renames or deletes branches. Give them the command.",
    match = ["git branch -D old", "git branch --copy old new"],
    not_match = ["git branch", "git branch -a", "git branch --merged main"],
)

prefix_rule(
    pattern = ["git", "stash", ["push", "pop", "apply", "drop", "clear", "branch", "save", "create", "store", "export", "import"]],
    decision = "forbidden",
    justification = "Stash writes move or discard work. Leave them to the user; list and show remain reads. The hook also blocks bare git stash.",
    match = ["git stash push", "git stash pop", "git stash clear"],
    not_match = ["git stash list", "git stash show -p"],
)

prefix_rule(
    pattern = ["git", "worktree", ["add", "move", "remove", "prune", "repair", "lock", "unlock"]],
    decision = "forbidden",
    justification = "Only the user changes worktrees. Continue in the session's original checkout.",
    match = ["git worktree add ../wt main", "git worktree remove ../wt"],
    not_match = ["git worktree list"],
)

prefix_rule(
    pattern = ["git", "remote", ["add", "remove", "rm", "rename", "set-url", "set-head", "prune", "update"]],
    decision = "forbidden",
    justification = "Changing remotes or fetching is a git write the user runs. Give them the command.",
    match = ["git remote set-url origin example", "git remote update"],
    not_match = ["git remote -v", "git remote get-url origin", "git remote show origin"],
)

prefix_rule(
    pattern = ["git", "config", ["set", "unset", "rename-section", "remove-section", "edit", "-e", "--add", "--unset", "--unset-all", "--replace-all", "--rename-section", "--remove-section", "--edit"]],
    decision = "forbidden",
    justification = "Only the user changes git configuration. Give them the command.",
    match = ["git config set user.name example", "git config --unset user.name"],
    not_match = ["git config get user.name", "git config --list"],
)

prefix_rule(
    pattern = ["git", "tag", ["-d", "--delete", "-f", "--force"]],
    decision = "forbidden",
    justification = "Only the user writes tags. Give them the command; the hook also blocks creating a tag by name.",
    match = ["git tag -d old", "git tag --force latest"],
    not_match = ["git tag", "git tag --list"],
)

prefix_rule(
    pattern = ["git", "reflog", ["expire", "delete", "drop", "write"]],
    decision = "forbidden",
    justification = "Reflog writes can destroy recovery history. Leave them to the user.",
    match = ["git reflog expire --expire=now --all"],
    not_match = ["git reflog", "git reflog show"],
)

prefix_rule(
    pattern = ["git", "commit", "--amend"],
    decision = "forbidden",
    justification = "Only new commits are permitted after the user asks. Give the user the amend command; the hook checks reordered flags too.",
    match = ["git commit --amend --no-edit"],
    not_match = ["git commit -m message"],
)

prefix_rule(
    pattern = ["git", "push", ["-f", "--force", "--force-with-lease", "--force-if-includes", "-d", "--delete", "--mirror", "--prune"]],
    decision = "forbidden",
    justification = "Only a plain push is permitted after the user asks. Leave remote history rewrites and ref deletion to the user.",
    match = ["git push --force origin main", "git push --delete origin old"],
    not_match = ["git push origin main"],
)
