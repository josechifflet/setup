# Prompt for deletion regardless of option ordering or recursive flags.
# Prefix rules do not inspect commands hidden inside scripts or other tools.
prefix_rule(
    pattern = [["rm", "rmdir", "trash"]],
    decision = "prompt",
    justification = "The user approves deleting data. Confirm the exact targets, including generated directories, before executing.",
    match = ["rm -rf dist", "rm -f -r dist", "rm file.txt", "rmdir tmp", "trash dist"],
    not_match = ["ls dist"],
)
