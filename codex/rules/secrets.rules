# Prompt at the executable boundary so implicit reads and reordered flags are
# covered. This also prompts for metadata-only uses of these credential tools.
# Plain-file reads (including config.toml headers) are outside this rule's reach.
prefix_rule(
    pattern = [["pass", "security", "sops"]],
    decision = "prompt",
    justification = "Credential tools may expose or change secrets. Confirm the target and avoid printing secret values into transcripts.",
    match = [
        "pass github/token",
        "pass show github/token",
        "pass insert service/token",
        "security -q find-generic-password -s service -w",
        "sops --output /tmp/result --decrypt secrets.yaml",
    ],
    not_match = ["shellcheck scripts/bootstrap"],
)
