# Every rule here covers a command whose whole purpose is to print a credential
# to stdout, where it lands in the transcript and in the shell history. Prompt,
# not forbid: reading a secret is sometimes the task, and the check that matters
# is whether the output is about to be echoed somewhere it persists.
#
# A credential kept in a plain file, such as the context7 header in
# ~/.codex/config.toml, is covered by nothing here.

prefix_rule(
    pattern = [["pass"], ["show", "insert", "edit", "rm"]],
    decision = "prompt",
    justification = "`pass` reveals or mutates a stored secret; check the path and where the output goes.",
    match = [
        "pass show github/token",
        "pass insert service/token",
        "pass rm service/token",
    ],
    not_match = [
        "pass ls",
        "pass git status",
    ],
)

prefix_rule(
    pattern = [["security"], ["find-generic-password", "find-internet-password"]],
    decision = "prompt",
    justification = "A macOS keychain read prints the secret with -w; check the service and redact the output.",
    match = [
        "security find-generic-password -s service -w",
        "security find-internet-password -s example.com -w",
    ],
    not_match = [
        "security list-keychains",
        "security find-certificate -a",
    ],
)

prefix_rule(
    pattern = [["sops"], ["-d", "--decrypt", "--encrypt", "--rotate", "edit"]],
    decision = "prompt",
    justification = "`sops` decrypts to stdout or rewrites recipients; check both before running it.",
    match = [
        "sops -d secrets.yaml",
        "sops edit secrets.yaml",
    ],
    not_match = [
        "sops --version",
    ],
)
